@echo off
chcp 65001 >nul
echo ========================================================
echo   Git Commit and Push (НПФ «АМК Горизонт»)
echo ========================================================

set "MSG=%~1"
if "%MSG%"=="" (
    set /p "MSG=Введите сообщение коммита: "
)

if "%MSG%"=="" (
    echo [ОШИБКА] Сообщение коммита не может быть пустым!
    pause
    exit /b 1
)

echo.
echo [1/3] Добавление файлов в индекс (git add -A)...
git add -A

echo.
echo [2/3] Создание локального коммита (git commit)...
git commit -m "%MSG%"
if errorlevel 1 (
    echo [ПРЕДУПРЕЖДЕНИЕ] Нет изменений для коммита или произошла ошибка.
)

echo.
echo [3/3] Отправка в удаленный репозиторий (git push origin main)...
git push origin main
if errorlevel 1 (
    echo [ОШИБКА] Не удалось выполнить git push!
    pause
    exit /b 1
)

echo.
echo ========================================================
echo   Успешно закоммичено и отправлено в репозиторий!
echo ========================================================
if "%~1"=="" pause
